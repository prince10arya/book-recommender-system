# OpenRouter API key — used for embeddings (OpenAI-compatible endpoint)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the embedding model (default: openai/text-embedding-3-small)
# Any OpenRouter embedding model slug works, e.g.:
#   openai/text-embedding-3-large
#   cohere/embed-english-v3.0
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Service token for internal endpoints (POST /upload, POST /embed, etc.)
SERVICE_TOKEN=dev-secret-token

# Set to "true" to require X-Token on the public /recommend endpoint too
REQUIRE_TOKEN=false
